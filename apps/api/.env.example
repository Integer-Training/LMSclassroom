# Required
# Supabase Postgres. Runtime uses the TRANSACTION POOLER (port 6543); the driver
# sets prepare:false + SSL for it (see packages/db/src/drizzle.ts).
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations use the DIRECT / session connection (port 5432) — set DIRECT_DATABASE_URL.
#   DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SSL is required by default; set DATABASE_SSL=disable only for a plain local Postgres.
DATABASE_URL=""
DIRECT_DATABASE_URL=""
REDIS_URL=""
PUBLIC_SERVER_URL=""

TRUSTED_ORIGINS=""
BETTER_AUTH_SECRET=""

AUTH_COOKIE_DOMAIN=""

# Email provider — used by the API only for auth-flow emails (forgot
# password, password-reset confirmation, email verification, email-change
# verification). Every other email is sent by @cio/jobs-worker; see
# apps/jobs/.env.example. Both processes can point at the same SMTP server.
# Sender identity is fully env-driven (SMTP_SENDER = From, SMTP_REPLY_TO = Reply-To).
#
# LOCAL (Mailpit):   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  user/pass empty  SMTP_ALLOW_INSECURE=true
# PRODUCTION (pick a provider — placeholders below; e.g. Zoho ZeptoMail / AWS SES /
#   Postmark / Resend SMTP): set real host/port (587 STARTTLS or 465 TLS)/user/pass.
SMTP_HOST=""                                   # prod: smtp.<provider>.com
SMTP_PORT=""                                   # prod: 587 (STARTTLS) or 465 (implicit TLS)
SMTP_USER=""                                   # prod: provider SMTP username
SMTP_PASSWORD=""                               # prod: provider SMTP password / API token
SMTP_SENDER=""                                 # e.g. '"Pearl LMS" <noreply@yourdomain>'
SMTP_REPLY_TO=""                               # e.g. '"Pearl LMS Support" <support@yourdomain>'

# Optional Zoho ZeptoMail token. When set, @cio/email uses Zoho instead of
# nodemailer/SMTP. Same dual-process note as SMTP above.
# ZOHO_TOKEN=""

# Local dev only: allow an unauthenticated, non-TLS SMTP catcher (bundled Mailpit
# at 127.0.0.1:1025). When true, SMTP auth becomes optional and STARTTLS is not
# forced. Leave UNSET for any real SMTP provider. Also set in apps/jobs/.env.
# SMTP_ALLOW_INSECURE="true"

# Object storage — Supabase Storage (S3-compatible). Generate S3 access keys in the
# Supabase dashboard: Project Settings -> Storage -> S3 Access Keys.
#   Endpoint:  https://<project-ref>.storage.supabase.co/storage/v1/s3
#   Region:    the project's region (e.g. eu-west-1)
#   Path-style addressing is REQUIRED for Supabase S3 (OBJECT_STORAGE_FORCE_PATH_STYLE=true).
# Buckets are PRIVATE (documents, videos) — files are served through the app via
# presigned URLs. The media bucket is public-read (images/thumbnails/avatars) and is
# served via OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL.
OBJECT_STORAGE_ENDPOINT=""            # https://<ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_PUBLIC_ENDPOINT=""     # same as endpoint (Supabase endpoint is browser-reachable)
OBJECT_STORAGE_REGION=""              # e.g. eu-west-1
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE="true"
OBJECT_STORAGE_BUCKET_VIDEOS="videos"
OBJECT_STORAGE_BUCKET_DOCUMENTS="documents"
OBJECT_STORAGE_BUCKET_MEDIA="media"
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=""  # https://<ref>.storage.supabase.co/storage/v1/object/public/media

# Optional - Cloudflare R2 (for hosted deployments)
CLOUDFLARE_BUCKET_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_BUCKET_DOMAIN=""
CLOUDFLARE_SECRET_ACCESS_KEY=""

# HMAC secret used to sign the `cio_hls` playback cookie. The same value must
# be set on the tenant-router Worker (`wrangler secret put HLS_SIGNING_SECRET`)
# so segments served from R2 at the edge verify against this signature.
# Without it the cookie endpoints return 503 and HLS playback won't start —
# uploads still work, so leave it unset for upload-only local development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HLS_SIGNING_SECRET=""

# Sentry (server-side error tracking). Leave SENTRY_DSN unset to disable.
# Skipped automatically in dev (NODE_ENV !== 'production') and self-hosted (PUBLIC_IS_SELFHOSTED=true).
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0"

# BullMQ dashboard (/admin/queues) ───────────────────────────────────────────
# In dev the dashboard is open. In production it's hidden unless ONE of the
# following is set; failing requests get 404 (not 401) so the route stays
# invisible to scanners.
#
# Comma-separated allowlist of Better Auth user emails — log in normally,
# visit /admin/queues, the middleware checks your session.
# QUEUE_DASHBOARD_ADMIN_EMAILS="you@yourdomain.com,partner@yourdomain.com"
#
# Bearer-token escape hatch for curl / scripts. Pass via
# `Authorization: Bearer <token>` or `?token=<token>`.
# QUEUE_DASHBOARD_TOKEN=""

# Enterprise (Optional)
# Required only when using Enterprise-only features (SSO, token-auth, no-tracking)
LICENSE_KEY=""

# SSO (Optional)
# For enterprise SSO with SAML (future support)
# SSO_ENCRYPTION_KEY="your-32-character-secret-key"

# AI Assistant (Optional)
# Per-provider API keys. The dashboard model picker exposes Gemini 3 Flash
# (Google) and GPT-4o (OpenAI). Anthropic is supported in code but not in the
# picker UI. Set at least one key to enable the assistant.
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
MOONSHOT_API_KEY=""

# Jina Reader — optional Bearer for higher rate limits when using fetch_documentation_url
# JINA_API_KEY=""
# AGENT_MAX_FETCHES_PER_CONVERSATION=15
# AGENT_MAX_FETCHES_PER_ORG_PER_DAY=500

# Upload file size limits (megabytes). Set these on both API and dashboard for self-hosted installs.
# UPLOAD_MAX_DOCUMENT_MB=5
# UPLOAD_MAX_IMAGE_MB=5
# UPLOAD_MAX_VIDEO_MB=800
# UPLOAD_MAX_EXERCISE_FILE_MB=2
# UPLOAD_MAX_AGENT_DOCUMENT_MB=5
# UPLOAD_MAX_LANDING_IMAGE_MB=0.5
# UPLOAD_MAX_THUMBNAIL_MB=5

# Tinybird event tracking for AI observability (optional — silently skipped when not set)
# TINYBIRD_TOKEN=""
# TINYBIRD_BASE_URL="https://api.tinybird.co"