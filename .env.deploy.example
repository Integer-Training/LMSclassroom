# PearlLMS production deploy env (Shape A). Copy to `.env` ON THE DROPLET and fill in.
# NEVER commit the real .env — it is gitignored. docker compose reads `.env` automatically.
#   cp .env.deploy.example .env   # then edit
# All secrets live here on the droplet only; see docs/DEPLOY.md.

# ── Public URL + domain ──────────────────────────────────────────────────────
# Your https app URL and the bare domain (A record -> droplet IP). Caddy issues TLS
# for APP_DOMAIN; PUBLIC_APP_URL is the same host with https://.
APP_DOMAIN=lms.yourdomain.com
PUBLIC_APP_URL=https://lms.yourdomain.com

# ── Auth secrets (generate fresh: openssl rand -hex 32) ──────────────────────
BETTER_AUTH_SECRET=
PRIVATE_SERVER_KEY=

# ── Supabase Postgres (same project as local) ────────────────────────────────
# Runtime = transaction pooler (6543); migrations = direct/session (5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ── Supabase Storage (S3-compatible; same project) ───────────────────────────
OBJECT_STORAGE_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_VIDEOS=videos
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_MEDIA=media
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=https://<ref>.storage.supabase.co/storage/v1/object/public/media

# CSP: allow the Supabase Storage host so browser presigned uploads/downloads and public
# media images are not blocked (self-hosted CSP starts from 'self' only). Use the S3 host.
CSP_CONNECT_SRC_DOMAINS=https://<ref>.storage.supabase.co
CSP_MEDIA_SRC_DOMAINS=https://<ref>.storage.supabase.co

# ── Real SMTP (production; NOT Mailpit) ──────────────────────────────────────
# 587 = STARTTLS, 465 = implicit TLS. Do NOT set SMTP_ALLOW_INSECURE in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER="Pearl LMS <noreply@yourdomain>"
SMTP_REPLY_TO="Pearl LMS Support <support@yourdomain>"

# ── AGPL source link (optional; defaults to the fork repo) ───────────────────
PUBLIC_SOURCE_REPO_URL=https://github.com/Integer-Training/LMSclassroom

# ── Optional integrations (leave unset unless used) ──────────────────────────
# OPENAI_API_KEY=

# ── Resource limits and DB pools (K4 starting points; all optional) ──────────
# Leave unset to use the defaults baked into docker-compose.deploy.yaml. Sizing and the connection budget table are in
# docs/DEPLOY.md. Do NOT raise the pool sizes before checking the Supabase pooler pool_size (budget = api + jobs + migrate).
# DATABASE_POOL_MAX=10            # api postgres-js pool (code default 10)
# JOBS_DATABASE_POOL_MAX=10       # jobs worker pool (code default 10)
# API_MEM_LIMIT=768m
# API_NODE_OPTIONS=--max-old-space-size=576
# DASHBOARD_MEM_LIMIT=768m
# DASHBOARD_NODE_OPTIONS=--max-old-space-size=576
# JOBS_MEM_LIMIT=1200m
# JOBS_CPUS=1.0
# JOBS_NODE_OPTIONS=--max-old-space-size=512
# REDIS_MEM_LIMIT=512m
# CADDY_MEM_LIMIT=128m
# MEDIA_WORKER_CONCURRENCY=2
# TRANSCRIBE_WORKER_CONCURRENCY=1
# AGENT_COURSE_GENERATION_WORKER_CONCURRENCY=1

# ── Error tracking (Sentry; OFF unless BOTH the DSN and the opt-in flag are set) ──
# No PII is sent (sendDefaultPii=false). api = SENTRY_*, browser = PUBLIC_SENTRY_* (the browser also needs the Sentry ingest
# host added to CSP_CONNECT_SRC_DOMAINS above). Traces default to 5%, session replay stays off.
# SENTRY_DSN=
# SENTRY_ENABLED=true
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# PUBLIC_SENTRY_DSN=
# PUBLIC_SENTRY_ENABLED=true
# PUBLIC_SENTRY_ENVIRONMENT=production
# PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
