# Connection strings for the @cio/db scripts (db:setup, db:reset, baseline, drizzle-kit).
# These run DDL / advisory locks / drizzle-kit migrate, so they use the DIRECT
# (session, port 5432) Supabase connection — NOT the transaction pooler (6543).
#
#   DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DATABASE_URL (pooled 6543) is optional here — it's only used as a fallback if
# DIRECT_DATABASE_URL is unset. SSL is required by default (Supabase); set
# DATABASE_SSL=disable only for a plain local Postgres.
DIRECT_DATABASE_URL=""
DATABASE_URL=""
